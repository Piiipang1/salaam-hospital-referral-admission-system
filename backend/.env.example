# ─── Salaam Hospital — Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database connection ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=salaam_hospital

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ── MySQL tool paths (XAMPP) ───────────────────────────────────────────────────
# Required if mysqldump / mysql are NOT on your system PATH.
# For XAMPP on Windows, set both of these:

MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump
MYSQL_PATH=C:\xampp\mysql\bin\mysql

# On macOS/Linux with XAMPP:
# MYSQLDUMP_PATH=/Applications/XAMPP/xamppfiles/bin/mysqldump
# MYSQL_PATH=/Applications/XAMPP/xamppfiles/bin/mysql

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
