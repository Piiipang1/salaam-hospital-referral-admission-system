# ─── Salaam Hospital — Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database connection ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=salaam_hospital

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a fresh, long random secret PER DEPLOYMENT — never reuse this
# placeholder or share a secret between environments. 64 hex chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (or: openssl rand -hex 32)
# Rotating JWT_SECRET invalidates all active sessions (everyone must log in
# again) — that is expected and is the intended way to force-revoke tokens.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ── MySQL tool paths (XAMPP) ───────────────────────────────────────────────────
# Required if mysqldump / mysql are NOT on your system PATH.
# For XAMPP on Windows, set both of these:

MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump
MYSQL_PATH=C:\xampp\mysql\bin\mysql

# On macOS/Linux with XAMPP:
# MYSQLDUMP_PATH=/Applications/XAMPP/xamppfiles/bin/mysqldump
# MYSQL_PATH=/Applications/XAMPP/xamppfiles/bin/mysql

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS ───────────────────────────────────────────────────────────────────────
# The frontend origin allowed to call this API. In production set this to your
# deployed frontend URL (e.g. https://salaam-hospital.onrender.com). Defaults to
# http://localhost:5173 (Vite dev server) when unset.
CLIENT_URL=http://localhost:5173
