{
  "name": "salaam-hospital-backend",
  "version": "1.0.0",
  "description": "Express.js REST API for the Salaam Hospital Referral and Admission System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "uploads/"
    ],
    "delay": "500"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.5",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Abdul Naafi A. Macapodi, Alimar B. Datunaim, Al-raafi C. Indanan",
  "license": "ISC"
}
